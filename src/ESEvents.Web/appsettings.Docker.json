{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "Host": "mailpit",
    "Port": 1025,
    "FromAddress": "no-reply@esevents.local",
    "FromName": "E-S Events",
    "UseSsl": false
  },
  "ConnectionStrings": {
    "Default": "Host=postgresql;Database=esevents;Username=postgres;Password=postgres;Port=5432"
  },
  "Cassandra": {
    "Port": 9042,
    "SocketOptions": {
      "ConnectTimeoutMillis": 5000,
      "ReadTimeoutMillis": 12000
    },
    "ContactPoints": [
      "cassandra"
    ],
    "ReplicationFactor": 1,
    "ConsistencyLevel": "LOCAL_QUORUM",
    "Keyspace": "chat_logs",
    "PageSize": 100
  },
  "Chat": {
    "PageSize": 50,
    "MessageRetentionDays": 30,
    "MaxMessageLength": 5000
  }
}
