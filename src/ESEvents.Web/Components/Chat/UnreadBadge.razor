@using ESEvents.Application.Chat

@if (UnreadCount > 0)
{
    <MudBadge Content="@UnreadCount" 
              Color="Color.Error" 
              Overlap="true"
              Class="unread-badge">
        <MudChip T="string" Icon="@Icons.Material.Filled.Circle" Size="Size.Small" />
    </MudBadge>
}

@code {
    [Parameter]
    public int UnreadCount { get; set; } = 0;

    [Parameter]
    public string Label { get; set; } = "Unread";
}

<style>
.unread-badge {
    animation: badge-pulse 2s infinite;
}

@@keyframes badge-pulse {
    0%, 100% {
        opacity: 1;
    }
    50% {
        opacity: 0.7;
    }
}
</style>
